rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'swapnilmahfuz20@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validCampaign(slug) {
      let data = request.resource.data;
      return slug.matches('[a-z0-9]+(-[a-z0-9]+)*') && slug.size() <= 80
        && data.keys().hasOnly(['title', 'description', 'frames', 'defaultId'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.frames is list && data.defaultId is string;
    }
    match /drafts/{slug} {
      allow read, delete: if owner();
      allow create, update: if owner() && validCampaign(slug);
    }
    match /live/{slug} {
      // Only explicitly published snapshots are stored in this collection.
      allow read: if true;
      allow delete: if owner();
      allow create, update: if owner() && validCampaign(slug);
    }
  }
}
