  },
  "devDependencies": {
    "@firebase/util": "^1.15.3",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.13.0",
    "firebase-tools": "^15.0.0",
    "playwright": "^1.58.0"
  }
}
